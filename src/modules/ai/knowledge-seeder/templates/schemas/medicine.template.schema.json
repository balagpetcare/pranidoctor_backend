{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pranidoctor.local/schemas/knowledge/medicine.template.schema.json",
  "title": "PraniDoctor Medicine Knowledge Import Row",
  "description": "Production import structure for VKL MEDICINE domain entities. Dose data must come from registered labels or handbooks.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slug",
    "domain",
    "titleBn",
    "titleEn",
    "bodyBn",
    "bodyEn",
    "sourceSpanRefs",
    "structuredJson"
  ],
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "domain": { "const": "MEDICINE" },
    "entityType": { "type": "string", "default": "Drug" },
    "titleBn": { "type": "string", "minLength": 1 },
    "titleEn": { "type": "string", "minLength": 1 },
    "bodyBn": { "type": "string", "minLength": 1 },
    "bodyEn": { "type": "string", "minLength": 1 },
    "species": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "audience": { "enum": ["FARMER", "DOCTOR", "BOTH"] },
    "regionScope": { "enum": ["BD", "GLOBAL"], "default": "BD" },
    "clinicalRiskTier": { "enum": ["HIGH", "CRITICAL"] },
    "chunkPolicyId": { "const": "MEDICINE_BY_SECTION" },
    "structuredJson": {
      "type": "object",
      "required": ["genericName"],
      "properties": {
        "genericName": { "type": "string" },
        "drugClass": { "type": "string" },
        "prescriptionRequired": { "type": "boolean" },
        "brandNamesBd": { "type": "array", "items": { "type": "string" } },
        "speciesDoseMatrix": { "type": "array" },
        "routes": { "type": "array", "items": { "type": "string" } },
        "contraindications": { "type": "array", "items": { "type": "string" } }
      }
    },
    "sourceSpanRefs": { "type": "array", "minItems": 1 }
  }
}
