{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pranidoctor.local/schemas/knowledge/reproduction.template.schema.json",
  "title": "PraniDoctor Reproduction Knowledge Import Row",
  "type": "object",
  "additionalProperties": false,
  "required": ["slug", "domain", "titleBn", "titleEn", "bodyBn", "bodyEn", "sourceSpanRefs"],
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "domain": { "const": "REPRODUCTION" },
    "entityType": {
      "enum": ["BreedingProtocol", "EstrusSign", "PregnancyStage", "ParturitionGuide"]
    },
    "titleBn": { "type": "string", "minLength": 1 },
    "titleEn": { "type": "string", "minLength": 1 },
    "bodyBn": { "type": "string", "minLength": 1 },
    "bodyEn": { "type": "string", "minLength": 1 },
    "species": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "regionScope": { "enum": ["BD"], "default": "BD" },
    "clinicalRiskTier": { "enum": ["LOW", "MEDIUM", "HIGH"] },
    "chunkPolicyId": { "enum": ["GENERIC_BY_PARAGRAPH", "STRUCTURED_BY_KEY"] },
    "structuredJson": { "type": "object" },
    "sourceSpanRefs": { "type": "array", "minItems": 1 }
  }
}
