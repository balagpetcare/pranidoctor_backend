{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pranidoctor.local/schemas/knowledge/feed.template.schema.json",
  "title": "PraniDoctor Feed Knowledge Import Row",
  "type": "object",
  "additionalProperties": false,
  "required": ["slug", "domain", "titleBn", "titleEn", "bodyBn", "bodyEn", "sourceSpanRefs", "structuredJson"],
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "domain": { "const": "FEED" },
    "entityType": { "type": "string", "default": "FeedIngredient" },
    "titleBn": { "type": "string", "minLength": 1 },
    "titleEn": { "type": "string", "minLength": 1 },
    "bodyBn": { "type": "string", "minLength": 1 },
    "bodyEn": { "type": "string", "minLength": 1 },
    "regionScope": { "enum": ["BD"], "default": "BD" },
    "clinicalRiskTier": { "enum": ["LOW", "MEDIUM"] },
    "chunkPolicyId": { "const": "FEED_BY_NUTRIENT_BLOCK" },
    "structuredJson": {
      "type": "object",
      "required": ["ingredientCode"],
      "properties": {
        "ingredientCode": { "type": "string" },
        "dmPercent": { "type": "number" },
        "cpPercent": { "type": "number" },
        "tdnPercent": { "type": "number" },
        "ndfPercent": { "type": "number" },
        "costTierBd": { "type": "string" }
      }
    },
    "sourceSpanRefs": { "type": "array", "minItems": 1 }
  }
}
