{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pranidoctor.local/schemas/knowledge/knowledge-import.template.schema.json",
  "title": "PraniDoctor Knowledge Import Bundle Row",
  "description": "Master import row schema for Phase 6E population bundles (CSV or JSON array).",
  "type": "object",
  "required": ["slug", "domain", "titleBn", "titleEn", "bodyBn", "bodyEn", "sourceSpanRefs"],
  "properties": {
    "slug": { "type": "string" },
    "domain": {
      "enum": ["DISEASE", "MEDICINE", "VACCINE", "FEED", "BREED", "REPRODUCTION", "EMERGENCY", "CLINICAL_PROTOCOL"]
    },
    "entityType": { "type": "string" },
    "titleBn": { "type": "string" },
    "titleEn": { "type": "string" },
    "summaryBn": { "type": "string" },
    "summaryEn": { "type": "string" },
    "bodyBn": { "type": "string" },
    "bodyEn": { "type": "string" },
    "species": { "type": "array", "items": { "type": "string" } },
    "audience": { "enum": ["FARMER", "DOCTOR", "BOTH"] },
    "regionScope": { "enum": ["BD", "GLOBAL"] },
    "clinicalRiskTier": { "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
    "chunkPolicyId": { "type": "string" },
    "keywordsBn": { "type": "array", "items": { "type": "string" } },
    "keywordsEn": { "type": "array", "items": { "type": "string" } },
    "colloquialBn": { "type": "array", "items": { "type": "string" } },
    "structuredJson": { "type": "object" },
    "sourceSpanRefs": { "type": "array", "minItems": 1 }
  }
}
