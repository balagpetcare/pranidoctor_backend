{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pranidoctor.local/schemas/knowledge/clinical-protocol.template.schema.json",
  "title": "PraniDoctor Clinical Protocol Knowledge Import Row",
  "type": "object",
  "additionalProperties": false,
  "required": ["slug", "domain", "titleBn", "titleEn", "bodyBn", "bodyEn", "sourceSpanRefs", "structuredJson"],
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "domain": { "const": "CLINICAL_PROTOCOL" },
    "entityType": {
      "enum": ["SOP", "DiagnosticWorkup", "TreatmentPathway", "BiosecurityMeasure"]
    },
    "titleBn": { "type": "string", "minLength": 1 },
    "titleEn": { "type": "string", "minLength": 1 },
    "bodyBn": { "type": "string", "minLength": 1 },
    "bodyEn": { "type": "string", "minLength": 1 },
    "audience": { "enum": ["DOCTOR", "BOTH"] },
    "regionScope": { "enum": ["BD"], "default": "BD" },
    "clinicalRiskTier": { "enum": ["MEDIUM", "HIGH"] },
    "chunkPolicyId": { "const": "PROTOCOL_BY_STEP" },
    "structuredJson": {
      "type": "object",
      "required": ["procedureCode"],
      "properties": {
        "procedureCode": { "type": "string" },
        "steps": { "type": "array" },
        "ppeRequired": { "type": "boolean" }
      }
    },
    "sourceSpanRefs": { "type": "array", "minItems": 1 }
  }
}
