{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pranidoctor.local/schemas/knowledge/emergency.template.schema.json",
  "title": "PraniDoctor Emergency Knowledge Import Row",
  "type": "object",
  "additionalProperties": false,
  "required": ["slug", "domain", "titleBn", "titleEn", "bodyBn", "bodyEn", "sourceSpanRefs", "structuredJson"],
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "domain": { "const": "EMERGENCY" },
    "entityType": { "type": "string", "default": "EmergencyCondition" },
    "titleBn": { "type": "string", "minLength": 1 },
    "titleEn": { "type": "string", "minLength": 1 },
    "bodyBn": { "type": "string", "minLength": 1 },
    "bodyEn": { "type": "string", "minLength": 1 },
    "species": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "audience": { "enum": ["FARMER", "BOTH"] },
    "regionScope": { "enum": ["BD"], "default": "BD" },
    "clinicalRiskTier": { "enum": ["CRITICAL", "HIGH"] },
    "chunkPolicyId": { "const": "EMERGENCY_BY_ACTION" },
    "colloquialBn": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "structuredJson": {
      "type": "object",
      "required": ["vetRequiredWithinHours"],
      "properties": {
        "vetRequiredWithinHours": { "type": "integer", "minimum": 1 },
        "onsetSpeed": { "type": "string" },
        "farmerActionWindow": { "type": "string" },
        "homeStabilizationAllowed": { "type": "boolean" }
      }
    },
    "sourceSpanRefs": { "type": "array", "minItems": 1 }
  }
}
