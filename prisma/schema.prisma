model VkKnowledgeEntity {
  id                        String            @id @default(cuid())
  domain                    VkKnowledgeDomain
  entityType                String            @db.VarChar(64)
  slug                      String            @unique @db.VarChar(128)
  currentPublishedVersionId String?           @unique
  currentDraftVersionId     String?           @unique
  legacyEntryId             String?           @unique
  createdById               String?
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt

  versions         VkKnowledgeVersion[] @relation("EntityVersions")
  publishedVersion VkKnowledgeVersion?  @relation("PublishedPointer", fields: [currentPublishedVersionId], references: [id], onDelete: SetNull)
  draftVersion     VkKnowledgeVersion?  @relation("DraftPointer", fields: [currentDraftVersionId], references: [id], onDelete: SetNull)
  linksFrom        VkKnowledgeLink[]    @relation("UvkgLinkFrom")
  linksTo          VkKnowledgeLink[]    @relation("UvkgLinkTo")

  @@index([domain, entityType])
}

model VkKnowledgeVersion {
  id                  String                      @id @default(cuid())
  entityId            String
  versionNumber       Int
  supersedesVersionId String?
  status              VkVersionStatus             @default(DRAFT)
  titleBn             String
  titleEn             String
  summaryBn           String?                     @db.Text
  summaryEn           String?                     @db.Text
  bodyBn              String                      @db.Text
  bodyEn              String                      @db.Text
  species             LivestockSpecies[]
  audience            AiKnowledgeAudience         @default(FARMER)
  regionScope         String                      @default("BD") @db.VarChar(16)
  structuredJson      Json?
  keywordsBn          String[]
  keywordsEn          String[]
  colloquialBn        String[]
  searchText          String?                     @db.Text
  chunkPolicyId       String?                     @db.VarChar(64)
  clinicalRiskTier    AiKnowledgeClinicalRiskTier @default(LOW)
  embeddingStatus     AiKnowledgeEmbeddingStatus  @default(NOT_APPLICABLE)
  changeSummary       String?                     @db.Text
  changedFields       String[]
  diffJson            Json?
  aiGeneratedDraft    Boolean                     @default(false)
  importRunId         String?
  publishedAt         DateTime?
  deprecatedAt        DateTime?
  deprecationReason   String?                     @db.Text
  createdById         String?
  publishedById       String?
  submittedAt         DateTime?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  entity              VkKnowledgeEntity       @relation("EntityVersions", fields: [entityId], references: [id], onDelete: Cascade)
  supersedes          VkKnowledgeVersion?     @relation("VersionChain", fields: [supersedesVersionId], references: [id], onDelete: SetNull)
  supersededBy        VkKnowledgeVersion[]    @relation("VersionChain")
  publishedForEntity  VkKnowledgeEntity?      @relation("PublishedPointer")
  draftForEntity      VkKnowledgeEntity?      @relation("DraftPointer")
  citations           VkKnowledgeCitation[]
  reviews             VkKnowledgeReview[]
  approvals           VkKnowledgeApproval[]
  auditEvents         VkKnowledgeAuditEvent[]
  chunks              VkKnowledgeChunk[]
  evidenceRecords     VkKnowledgeEvidence[]
  confidenceRecords   VkKnowledgeConfidence[]
  changeRequests      VkKnowledgeChangeRequest[]
  governanceConflicts VkGovernanceConflict[]

  feedIngredients      VkFeedIngredient[]         @relation("FeedIngredientVersion")
  nutrientRequirements VkNutrientRequirement[]    @relation("NutrientRequirementVersion")
  toxicFeedAlerts      VkToxicFeedAlert[]         @relation("ToxicFeedAlertVersion")
  rationTemplates      VkRationTemplate[]         @relation("RationTemplateVersion")
  seasonalCalendars    VkSeasonalFeedCalendar[]   @relation("SeasonalCalendarVersion")
  medicineGenerics     MedicineGeneric[]          @relation("MedicineGenericVersion")
  knowledgeLinks       VkKnowledgeLink[]

  @@unique([entityId, versionNumber])
  @@index([entityId, status])
  @@index([status, clinicalRiskTier])
  @@index([publishedAt])
}

model VkKnowledgeCitation {
  id                 String   @id @default(cuid())
  versionId          String
  chunkId            String?
  sourceId           String
  documentId         String?
  pageRef            String?  @db.VarChar(64)
  sectionRef         String?  @db.VarChar(128)
  tableRef           String?  @db.VarChar(64)
  rowRef             String?  @db.VarChar(64)
  spanRefsJson       Json?
  contributionWeight Float    @default(1)
  quotedFrom         Boolean  @default(false)
  inlineCitationKey  String   @db.VarChar(128)
  humanCitationBn    String?  @db.Text
  humanCitationEn    String?  @db.Text
  accessedAt         DateTime @default(now())
  createdAt          DateTime @default(now())

  version  VkKnowledgeVersion           @relation(fields: [versionId], references: [id], onDelete: Cascade)
  chunk    VkKnowledgeChunk?            @relation(fields: [chunkId], references: [id], onDelete: SetNull)
  source   AiKnowledgeSource            @relation(fields: [sourceId], references: [id])
  document AiKnowledgeSourceDocument?   @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([versionId])
  @@index([chunkId])
  @@index([sourceId])
}

model VkKnowledgeChunk {
  id                String                @id @default(cuid())
  versionId         String
  chunkIndex        Int
  chunkPolicyId     String                @db.VarChar(64)
