model AiKnowledgeEntry {
  id                        String                      @id @default(cuid())
  contentType               AiKnowledgeContentType
  slug                      String                      @unique
  audience                  AiKnowledgeAudience         @default(FARMER)
  titleBn                   String
  titleEn                   String
  bodyBn                    String                      @db.Text
  bodyEn                    String                      @db.Text
  species                   LivestockSpecies[]
  status                    AiKnowledgeStatus           @default(DRAFT)
  version                   Int                         @default(1)
  publishedAt               DateTime?
  createdById               String?
  reviewedById              String?
  approvedByVetId           String?
  metadataJson              Json?
  searchText                String?                     @db.Text
  sourceId                  String?
  importRunId               String?
  chunkPolicyId             String?                     @db.VarChar(64)
  evidenceLevel             AiKnowledgeEvidenceLevel?
  provisionalEvidenceLevel  AiKnowledgeEvidenceLevel?
  confidenceScore           Float?
  provisionalConfidenceScore Float?
  clinicalRiskTier          AiKnowledgeClinicalRiskTier @default(LOW)
  embeddingStatus           AiKnowledgeEmbeddingStatus  @default(NOT_APPLICABLE)
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
  source                    AiKnowledgeSource?          @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  importRun                 AiKnowledgeImportRun?       @relation(fields: [importRunId], references: [id], onDelete: SetNull)
  symptomLinks              AiSymptomDiseaseLink[]
  chunks                    AiKnowledgeChunk[]
  embeddingChunks           AiKnowledgeEmbeddingChunk[]
  reviews                   AiKnowledgeReview[]
  approvals                 AiKnowledgeApproval[]
  medicineGeneric           MedicineGeneric?

  @@index([contentType, status])
  @@index([status])
  @@index([sourceId])
  @@index([importRunId])
  @@index([clinicalRiskTier, status])
}

model AiKnowledgeSourceLicense {
  id                       String               @id @default(cuid())
  licenseType              AiKnowledgeLicenseType
  allowsAiExtraction       Boolean              @default(true)
  allowsFarmerDistribution Boolean              @default(true)
  allowsVerbatimQuote      Boolean              @default(false)
  expiryDate               DateTime?
  attributionTemplateBn    String?              @db.Text
  attributionTemplateEn    String?              @db.Text
  rightsNote               String?              @db.Text
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  sources                  AiKnowledgeSource[]

  @@index([licenseType])
}

model AiKnowledgeSource {
  id                   String                       @id @default(cuid())
  sourceKey            String                       @unique @db.VarChar(128)
  sourceClass          AiKnowledgeSourceClass
  sourceType           AiKnowledgeCatalogSourceType
  titleBn              String
  titleEn              String
  publisher            String?
  publishYear          Int?
  edition              String?
  jurisdiction         String                       @default("BD") @db.VarChar(16)
  trustTier            Int                          @default(2)
  defaultEvidenceLevel AiKnowledgeEvidenceLevel     @default(L2)
  allowedDomains       AiKnowledgeContentType[]
  licenseId            String?
  refreshPolicyDays    Int?
  status               AiKnowledgeSourceStatus      @default(ACTIVE)
  metadataJson         Json?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  license              AiKnowledgeSourceLicense?    @relation(fields: [licenseId], references: [id], onDelete: SetNull)
  documents            AiKnowledgeSourceDocument[]
  importRuns           AiKnowledgeImportRun[]
  entries              AiKnowledgeEntry[]
  vkCitations          VkKnowledgeCitation[]

  @@index([sourceClass, status])
  @@index([status])
}

model AiKnowledgeSourceDocument {
  id                   String                       @id @default(cuid())
  sourceId             String
  documentVersion      String                       @db.VarChar(64)
  mediaType            AiKnowledgeDocumentMediaType
  storageUri           String                       @db.VarChar(512)
  checksumSha256       String                       @db.VarChar(64)
  pageCount            Int?
  languagePrimary      String                       @default("bn") @db.VarChar(8)
  parseProfileId       String?                      @db.VarChar(64)
  rightsNote           String?                      @db.Text
  supersedesDocumentId String?
  ingestedAt           DateTime                     @default(now())
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  source               AiKnowledgeSource            @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  importRuns           AiKnowledgeImportRun[]
  vkCitations          VkKnowledgeCitation[]

  @@unique([sourceId, checksumSha256])
  @@index([sourceId, ingestedAt])
}

model AiKnowledgeImportRun {
  id                     String                         @id @default(cuid())
  sourceId               String
  documentId             String?
  adapterId              String                         @db.VarChar(64)
  profileKey             String?                        @db.VarChar(64)
  pipelineVersion        String                         @default("6b2.0") @db.VarChar(16)
  mode                   String                         @default("LIVE") @db.VarChar(32)
  pipelineStage          AiKnowledgeImportPipelineStage @default(QUEUED)
  status                 AiKnowledgeImportRunStatus     @default(RUNNING)
  dryRun                 Boolean                        @default(false)
  triggeredById          String?
  statsJson              Json?
  validationSummaryJson  Json?
  errorSummary           String?                        @db.Text
  startedAt              DateTime                       @default(now())
  completedAt            DateTime?
  source                 AiKnowledgeSource              @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  document               AiKnowledgeSourceDocument?     @relation(fields: [documentId], references: [id], onDelete: SetNull)
  entries                AiKnowledgeEntry[]
  importJobs             AiKnowledgeImportJob[]
  validationItems        AiKnowledgeValidationItem[]
  quarantineRecords      AiKnowledgeQuarantineRecord[]

  @@index([sourceId, startedAt])
  @@index([status, startedAt])
  @@index([pipelineStage, startedAt])
}

model AiKnowledgeImportJob {
  id           String                     @id @default(cuid())
  importRunId  String
  jobStage     AiKnowledgeImportJobStage
  status       AiKnowledgeImportJobStatus @default(QUEUED)
  payloadJson  Json
  resultJson   Json?
  attemptCount Int                        @default(0)
  maxAttempts  Int                        @default(3)
  lastError    String?                    @db.Text
  scheduledAt  DateTime                   @default(now())
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt
  importRun    AiKnowledgeImportRun       @relation(fields: [importRunId], references: [id], onDelete: Cascade)

  @@index([importRunId, jobStage])
  @@index([status, scheduledAt])
}

model AiKnowledgeValidationItem {
  id           String                          @id @default(cuid())
  importRunId  String
  extractIndex Int
  payloadJson  Json
  status       AiKnowledgeValidationItemStatus @default(PENDING)
  failureCodes String[]
  waivedById   String?
  createdAt    DateTime                        @default(now())
  updatedAt    DateTime                        @updatedAt
  importRun    AiKnowledgeImportRun            @relation(fields: [importRunId], references: [id], onDelete: Cascade)

  @@index([importRunId, status])
  @@index([importRunId, extractIndex])
}

model AiKnowledgeQuarantineRecord {
  id              String               @id @default(cuid())
  importRunId     String
  extractIndex    Int?
  reasonCode      String               @db.VarChar(64)
  message         String?              @db.Text
  rawSnapshotJson Json?
  resolution      String?              @db.VarChar(32)
  resolvedAt      DateTime?
  createdAt       DateTime             @default(now())
  importRun       AiKnowledgeImportRun @relation(fields: [importRunId], references: [id], onDelete: Cascade)

  @@index([importRunId, reasonCode])
}

model AiKnowledgeChunk {
  id               String                @id @default(cuid())
  knowledgeEntryId String
  chunkIndex       Int
  chunkPolicyId    String                @db.VarChar(64)
  stage            AiKnowledgeChunkStage @default(STAGING)
  contentBn        String                @db.Text
  contentEn        String                @db.Text
  tokenEstimate    Int                   @default(0)
  headingPath      String?               @db.VarChar(256)
  citationJson     Json?
  metadataJson     Json?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  knowledgeEntry   AiKnowledgeEntry      @relation(fields: [knowledgeEntryId], references: [id], onDelete: Cascade)

  @@unique([knowledgeEntryId, chunkIndex, stage])
  @@index([knowledgeEntryId, stage])
}

model AiKnowledgeEmbeddingChunk {
  id                String           @id @default(cuid())
  knowledgeEntryId  String
  chunkIndex        Int
  entryVersion      Int
  providerKey       String           @db.VarChar(32)
  modelKey          String           @db.VarChar(128)
  dimensions        Int
  vectorJson        Json
  metadataSidecarJson Json?
  embeddingTextHash String           @db.VarChar(64)
  active            Boolean          @default(true)
  embeddedAt        DateTime         @default(now())
