  @@index([versionId, assessedAt])
}

model VkKnowledgeConfidence {
  id                    String                 @id @default(cuid())
  versionId             String
  score                 Float
  formulaVersion        String                 @default("v2") @db.VarChar(16)
  componentsJson        Json
  provisional           Boolean                @default(true)
