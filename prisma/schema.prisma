/// Phase 4 primary livestock registry (parallel to legacy AnimalProfile during migration).
model Livestock {
  id                    String                   @id @default(cuid())
  customerId            String
  farmRef               String
  deploymentBranch      String?
  legacyAnimalProfileId String?                  @unique
  name                  String
  species               LivestockSpecies
  customSpeciesLabel    String?
  breedId               String?
  breedName             String?
  gender                LivestockGender
  purpose               LivestockPurpose?        @default(MIXED)
  lifecycleStatus       LivestockLifecycleStatus @default(ACTIVE)
  healthStatus          LivestockHealthStatus    @default(HEALTHY)
  dateOfBirth           DateTime?                @db.Date
  weightKg              Decimal?                 @db.Decimal(10, 3)
  lastWeightAt          DateTime?
  earTagNumber          String?
  qrCodePayload         String?
  pregnancyStatus       PregnancyStatus?
  lactationNumber       Int?
  lastCalvingDate       DateTime?                @db.Date
  photoUrl              String?
  purchaseDate          DateTime?                @db.Date
  purchasePriceBdt      Decimal?                 @db.Decimal(12, 2)
  saleDate              DateTime?                @db.Date
  salePriceBdt          Decimal?                 @db.Decimal(12, 2)
  notes                 String?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  deletedAt             DateTime?
  customer              CustomerProfile          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  images                LivestockImage[]
  healthRecords         LivestockHealthRecord[]
  vaccinations          LivestockVaccination[]
  consumptions          FeedConsumption[]
  expenses              LivestockExpense[]
  recommendationLogs    FeedRecommendationLog[]
  feedFormulationRequests FeedFormulationRequest[]

  @@unique([customerId, earTagNumber])
  @@index([customerId, farmRef, lifecycleStatus])
  @@index([customerId, species])
  @@index([customerId, updatedAt])
  @@index([deploymentBranch])
  @@index([deletedAt])
}

model LivestockImage {
  id             String    @id @default(cuid())
  livestockId    String
  url            String
  uploadedFileId String?
  caption        String?
  sortOrder      Int       @default(0)
  createdAt      DateTime  @default(now())
  livestock      Livestock @relation(fields: [livestockId], references: [id], onDelete: Cascade)

  @@index([livestockId, sortOrder])
}

model LivestockHealthRecord {
  id           String                    @id @default(cuid())
  customerId   String
  livestockId  String
  farmRef      String?
  recordType   LivestockHealthRecordType
  title        String
  symptoms     String?
  diagnosis    String?
  diseaseName  String?
  treatmentRef String?
  notes        String?
  recordedDate DateTime                  @db.Date
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  livestock    Livestock                 @relation(fields: [livestockId], references: [id], onDelete: Cascade)

  @@index([customerId, recordedDate])
  @@index([livestockId, recordedDate])
  @@index([recordType])
}

model LivestockVaccination {
  id               String                     @id @default(cuid())
  customerId       String
  livestockId      String
  farmRef          String?
  vaccineName      String
  vaccineType      String?
  scheduledDate    DateTime                   @db.Date
  administeredDate DateTime?                  @db.Date
  nextDueDate      DateTime?                  @db.Date
  status           LivestockVaccinationStatus @default(SCHEDULED)
  batchNumber      String?
  notes            String?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  livestock        Livestock                  @relation(fields: [livestockId], references: [id], onDelete: Cascade)

  @@index([customerId, scheduledDate])
  @@index([customerId, status])
  @@index([livestockId])
}

/// Platform feed master item (Phase 4 catalog; coexists with FeedCatalog).
model FeedItem {
  id              String           @id @default(cuid())
  code            String           @unique
  category        FeedCategory
  nameBn          String
  nameEn          String
  defaultUnit     FeedUnit
  approxPriceBdt  Decimal?         @db.Decimal(12, 2)
  moistureType    FeedMoistureType @default(DRY)
  isSeasonal      Boolean          @default(false)
  seasonNotesBn   String?
  seasonNotesEn   String?
  restrictionJson Json?
  suitabilityJson Json?
  isSeeded        Boolean          @default(false)
  isActive        Boolean          @default(true)
  sortOrder       Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  nutrition       FeedNutrition?
  inventories     FeedInventory[]
  purchases       FeedPurchase[]
  consumptions    FeedConsumption[]
  vendorProducts  FeedVendorProduct[]
  vkIngredient    VkFeedIngredient?

  @@index([category, isActive])
  @@index([isActive, sortOrder])
}

model FeedNutrition {
  id          String   @id @default(cuid())
  feedItemId  String   @unique
  cpPercent   Decimal? @db.Decimal(6, 2)
  tdnPercent  Decimal? @db.Decimal(6, 2)
  cfPercent   Decimal? @db.Decimal(6, 2)
  eePercent   Decimal? @db.Decimal(6, 2)
  caPercent   Decimal? @db.Decimal(6, 2)
  pPercent    Decimal? @db.Decimal(6, 2)
  dmPercent   Decimal? @db.Decimal(6, 2)
  source      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  feedItem    FeedItem @relation(fields: [feedItemId], references: [id], onDelete: Cascade)
}

/// Per-farm feed stock (Phase 4).
model FeedInventory {
  id                 String           @id @default(cuid())
  customerId         String
  farmRef            String
  deploymentBranch   String?
  feedItemId         String?
  displayName        String
  unit               FeedUnit         @default(KG)
  quantityOnHand     Decimal          @default(0) @db.Decimal(12, 3)
  lowStockThreshold  Decimal?         @db.Decimal(12, 3)
  defaultBagWeightKg Decimal?         @db.Decimal(10, 3)
  allowNegativeStock Boolean          @default(false)
  isActive           Boolean          @default(true)
  deletedAt          DateTime?
  notes              String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  customer           CustomerProfile  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  feedItem           FeedItem?        @relation(fields: [feedItemId], references: [id], onDelete: SetNull)
  purchases          FeedPurchase[]
  consumptions       FeedConsumption[]

  @@unique([customerId, farmRef, displayName])
  @@index([customerId, farmRef, isActive])
  @@index([feedItemId])
  @@index([deploymentBranch])
}

model FeedPurchase {
  id              String          @id @default(cuid())
  customerId      String
  farmRef         String
  feedInventoryId String
  feedItemId      String?
  quantity        Decimal         @db.Decimal(12, 3)
  unit            FeedUnit
  unitCostBdt     Decimal?        @db.Decimal(12, 2)
  totalCostBdt    Decimal?        @db.Decimal(12, 2)
  supplierName    String?
  supplierPhone   String?
  purchasedAt     DateTime        @db.Date
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  customer        CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  feedInventory   FeedInventory   @relation(fields: [feedInventoryId], references: [id], onDelete: Cascade)
  feedItem        FeedItem?       @relation(fields: [feedItemId], references: [id], onDelete: SetNull)

  @@index([customerId, farmRef, purchasedAt])
  @@index([feedInventoryId])
}

model FeedConsumption {
  id              String          @id @default(cuid())
  customerId      String
  farmRef         String
  livestockId     String?
  feedInventoryId String?
  feedItemId      String?
  amount          Decimal         @db.Decimal(12, 3)
  unit            FeedUnit
  costBdt         Decimal?        @db.Decimal(12, 2)
  deductStock     Boolean         @default(false)
  recordedDate    DateTime        @db.Date
  notes           String?
  idempotencyKey  String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  customer        CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  livestock       Livestock?      @relation(fields: [livestockId], references: [id], onDelete: SetNull)
  feedInventory   FeedInventory?  @relation(fields: [feedInventoryId], references: [id], onDelete: SetNull)
  feedItem        FeedItem?       @relation(fields: [feedItemId], references: [id], onDelete: SetNull)

  @@unique([customerId, idempotencyKey])
  @@index([customerId, recordedDate])
  @@index([livestockId])
  @@index([feedInventoryId])
  @@index([feedItemId])
}

model FeedVendor {
  id                 String                       @id @default(cuid())
  name               String
  nameBn             String?
  phone              String?
  districtId         String?
  address            String?
  verificationStatus FeedVendorVerificationStatus @default(PENDING)
  isActive           Boolean                      @default(true)
  notes              String?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  products           FeedVendorProduct[]

  @@index([verificationStatus, isActive])
  @@index([districtId])
}

model FeedVendorProduct {
  id           String                 @id @default(cuid())
  vendorId     String
  feedItemId   String?
  displayName  String
  unit         FeedUnit
  unitWeightKg Decimal?               @db.Decimal(10, 3)
  priceBdt     Decimal?               @db.Decimal(12, 2)
  isActive     Boolean                @default(true)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  vendor       FeedVendor             @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  feedItem     FeedItem?              @relation(fields: [feedItemId], references: [id], onDelete: SetNull)

  @@index([vendorId, isActive])
  @@index([feedItemId])
}

model FeedRecommendationLog {
  id           String          @id @default(cuid())
  customerId   String
  livestockId  String
  planDate     DateTime        @db.Date
  ruleVersion  String
  itemsJson    Json
  totalsJson   Json
  warningsJson Json?
  accepted     Boolean         @default(false)
  createdAt    DateTime        @default(now())
  customer     CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  livestock    Livestock       @relation(fields: [livestockId], references: [id], onDelete: Cascade)

  @@index([livestockId, planDate])
  @@index([customerId, planDate])
}

model LivestockExpense {
  id           String          @id @default(cuid())
  customerId   String
  livestockId  String?
  farmRef      String?
  category     ExpenseCategory
  amountBdt    Decimal         @db.Decimal(12, 2)
  recordedDate DateTime        @db.Date
  notes        String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  customer     CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  livestock    Livestock?      @relation(fields: [livestockId], references: [id], onDelete: SetNull)

  @@index([customerId, recordedDate])
  @@index([livestockId])
  @@index([category])
}

model FeedAnalyticsCache {
  id           String          @id @default(cuid())
  customerId   String
  farmRef      String
  cacheKey     String
  periodStart  DateTime        @db.Date
  periodEnd    DateTime        @db.Date
  metricsJson  Json
  expiresAt    DateTime
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  customer     CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, farmRef, cacheKey])
  @@index([expiresAt])
}

model LivestockAuditLog {
  id          String               @id @default(cuid())
  customerId  String
  action      LivestockAuditAction
  entityType  String
  entityId    String?
  actorUserId String?
  payload     Json?
  createdAt   DateTime             @default(now())
  customer    CustomerProfile      @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
  @@index([entityType, entityId])
}

