model VkKnowledgeLink {
  id                String                      @id @default(cuid())
  linkKey           String                      @unique @db.VarChar(128)
  edgeType          String                      @db.VarChar(64)
  edgeClass         VkKnowledgeEdgeClass        @default(CLINICAL)
  fromEntityId      String?
  fromRefType       VkKnowledgeNodeRefType
  fromRefId         String                      @db.VarChar(128)
  toEntityId        String?
  toRefType         VkKnowledgeNodeRefType
  toRefId           String                      @db.VarChar(128)
  direction         VkKnowledgeLinkDirection    @default(DIRECTED)
  weight            Float                       @default(0.5)
  lineOrder         Int?
  species           LivestockSpecies[]
  regionScope       String[]                    @default(["BD"])
  evidenceLevel     String                      @default("L2") @db.VarChar(8)
  confidenceScore   Float                       @default(0.8)
  clinicalRiskTier  AiKnowledgeClinicalRiskTier @default(LOW)
  status            VkKnowledgeLinkStatus       @default(DRAFT)
  vkVersionId       String?
  sourceEdgeId      String?                     @db.VarChar(64)
  sourceSystem      VkKnowledgeLinkSourceSystem
  labelBn           String?
  labelEn           String?
  metadataJson      Json?
  effectiveFrom     DateTime                    @default(now())
  effectiveTo       DateTime?
  createdById       String?
  updatedById       String?
  publishedAt       DateTime?
  deprecatedAt      DateTime?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  fromEntity  VkKnowledgeEntity?  @relation("UvkgLinkFrom", fields: [fromEntityId], references: [id], onDelete: SetNull)
  toEntity    VkKnowledgeEntity?  @relation("UvkgLinkTo", fields: [toEntityId], references: [id], onDelete: SetNull)
  vkVersion   VkKnowledgeVersion? @relation(fields: [vkVersionId], references: [id], onDelete: SetNull)
  reviews     VkKnowledgeLinkReview[]
  approvals   VkKnowledgeLinkApproval[]
  auditEvents VkKnowledgeLinkAuditEvent[]

  @@index([edgeType, status])
  @@index([fromRefType, fromRefId])
  @@index([toRefType, toRefId])
  @@index([sourceSystem, sourceEdgeId])
  @@index([status, edgeClass])
  @@map("vk_knowledge_links")
}

model VkKnowledgeLinkStaging {
  id                String                      @id @default(cuid())
  linkKey           String                      @db.VarChar(128)
  edgeType          String                      @db.VarChar(64)
